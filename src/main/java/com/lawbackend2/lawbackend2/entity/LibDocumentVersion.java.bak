package com.lawbackend2.lawbackend2.entity;

import javax.persistence.*;
import lombok.*;

@Entity
@Table(name = "tb_lib_document_version", indexes = {
    @Index(name = "idx_lib_version_doc_id", columnList = "document_id"),
    @Index(name = "idx_lib_version_create_user_id", columnList = "create_user_id"),
    @Index(name = "idx_lib_version_create_time", columnList = "create_time")
}, uniqueConstraints = {
    @UniqueConstraint(name = "uk_lib_doc_version", columnNames = {"document_id", "version_number"})
})
@Data
@EqualsAndHashCode(callSuper = true)
@NoArgsConstructor
@AllArgsConstructor
public class LibDocumentVersion extends LibBaseEntity {

    @Column(name = "document_id", nullable = false)
    private Long documentId;

    @Column(name = "version_number", nullable = false)
    private Integer versionNumber;

    @Column(name = "version_name", length = 50)
    private String versionName;

    @Column(name = "file_name", nullable = false)
    private String fileName;

    @Column(name = "file_path", nullable = false, length = 500)
    private String filePath;

    @Column(name = "file_size")
    private Long fileSize = 0L;

    @Column(name = "change_summary", length = 1000)
    private String changeSummary;

    @Column(name = "change_type", length = 20)
    private String changeType = "UPDATE";

    @Column(name = "is_major")
    private Boolean isMajor = false;
}
