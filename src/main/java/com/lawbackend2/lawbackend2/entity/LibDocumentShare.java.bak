package com.lawbackend2.lawbackend2.entity;

import javax.persistence.*;
import lombok.*;

import java.time.LocalDateTime;

@Entity
@Table(name = "tb_lib_document_share", indexes = {
    @Index(name = "idx_lib_share_doc_id", columnList = "document_id"),
    @Index(name = "idx_lib_share_create_user_id", columnList = "create_user_id"),
    @Index(name = "idx_lib_share_expire_time", columnList = "expire_time")
}, uniqueConstraints = {
    @UniqueConstraint(name = "uk_lib_share_code", columnNames = {"share_code"})
})
@Data
@EqualsAndHashCode(callSuper = true)
@NoArgsConstructor
@AllArgsConstructor
public class LibDocumentShare extends LibBaseEntity {

    @Column(name = "document_id", nullable = false)
    private Long documentId;

    @Column(name = "share_code", nullable = false, length = 32)
    private String shareCode;

    @Column(name = "share_password", length = 20)
    private String sharePassword;

    @Column(name = "permission_type", length = 20)
    private String permissionType = "READ";

    @Column(name = "expire_time")
    private LocalDateTime expireTime;

    @Column(name = "max_access_count")
    private Integer maxAccessCount = 0;

    @Column(name = "access_count")
    private Integer accessCount = 0;

    @Column(name = "is_enabled")
    private Boolean isEnabled = true;
}
